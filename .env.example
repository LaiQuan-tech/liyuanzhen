# 對話大腦 + 文字 embedding（同一把 key 兩用）
# 開發期可沿用其他專案的 key；正式公開網址前務必換成本專案專屬 key，
# 並在 Google Cloud 設硬預算上限與告警——程式內的 rate limit 在多實例間不共享。
GEMINI_API_KEY=

# ── Stage 2：Supabase（沒設就自動走本機向量檔，不會壞）──────────
# 兩個都填上並重新部署 = 檢索自動切到 pgvector、表單開始收資料，零程式碼變更。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可選：強制指定檢索來源，值為 local | supabase
# 不設 = 有 Supabase 憑證就用 Supabase，沒有就用本機向量檔
RETRIEVAL_PROVIDER=

# 表單是否真的收資料（Stage 2 才設 false）
NEXT_PUBLIC_DEMO_MODE=true

# ── 語音輸入（/live 的按住說話）────────────────────────────────
# 語音轉文字沿用上面那把 GEMINI_API_KEY，不需要另外的憑證。
# 模型與參數釘死在 lib/stt/index.ts（gemini-3.5-flash ＋ thinkingBudget:0），
# 那是量出來的：flash-latest 3.4 秒、3.5-flash 關掉思考 1.0 秒。
# 沒設 GEMINI_API_KEY 時 /api/stt 回 503，前端會提示改用文字版。

# 可選：全站每日請求總量上限（跨所有端點共用的花費天花板）
# ⚠️ 單位是「請求」不是「問題」——語音一輪要打 stt→chat→tts 三支，
#    所以 4000 約等於 1300 輪語音對話。改的時候記得換算。
RATE_LIMIT_GLOBAL_PER_DAY=4000

# ── 串流虛擬人（LiveAvatar）────────────────────────────────────
# ⚠️ killswitch。預設關閉——沒有明確設成 true，/api/avatar-token 一律拒發，
#    也就沒有人能開始燒錢。這是三道閘門裡最外面那一道。
AVATAR_ENABLED=false

# LiveAvatar 帳號（注意是 api.liveavatar.com，不是 api.heygen.com；
# 2026 年從 HeyGen 拆出去之後是獨立網域、獨立帳單池）
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=

# 可選：沙盒模式。沙盒只允許官方的測試 avatar，用來驗協定不用花錢
LIVEAVATAR_SANDBOX=
LIVEAVATAR_TEST_AVATAR_ID=

# 帳本的三道閘門（lib/avatar-ledger）。都有預設值，通常不用動。
# ⚠️ AVATAR_MAX_SESSION_SECONDS 會被伺服器回給前端當硬上限——
#    /live 是多輪對話，設太短她會在講到一半時消失。
AVATAR_MAX_CONCURRENT=36
AVATAR_MONTHLY_MINUTES=30000
AVATAR_MAX_SESSION_SECONDS=180

# ── 她的聲音（ElevenLabs 克隆音）────────────────────────────────
# ⚠️ 這把 key 只需要 TTS 權限，不要給它帳號管理權限。
# ⚠️ 輸出格式固定 pcm_24000（裸 PCM，不是 WAV）——那是 LiveAvatar LITE
#    唯一吃得下的格式，加了 RIFF 標頭會每塊開頭爆音。見 lib/voice/pcm.ts。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── 前端旗標（NEXT_PUBLIC_ 會被打進瀏覽器，絕不可放憑證）──────────
# 數位人的呈現方式，值為 monogram | mock | heygen
#   monogram（預設）圓形「李」字標記 ＋ 瀏覽器 TTS。零成本、零肖像疑慮
#   mock            假時序、不連外、不計費。做版面與測互動用
#   heygen          真的串流虛擬人
# ⚠️ /live 不看這個變數（它一定要那張臉，所以直接指定 heygen），
#    唯一的例外是設成 mock 時它會跟著用 mock——那正是做版面時要的。
NEXT_PUBLIC_AVATAR_PROVIDER=

# 只給本機開發：讓 mock driver 顯示一張參考圖，看真人照片套進版面的樣子
# ⚠️ 不要設進 Vercel。參考圖多半是他人拍攝的既有照片，著作權不在我們手上。
NEXT_PUBLIC_AVATAR_PREVIEW_IMAGE=

# 只給 npm run smoke:chat 用，指向要測的站
SMOKE_BASE_URL=
